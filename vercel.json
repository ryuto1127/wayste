{
  "functions": {
    "app/api/classify/route.ts": {
      "maxDuration": 30,
      "regions": ["iad1"]
    },
    "app/api/cron/cleanup/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/export-finetuning/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/export-finetuning",
      "schedule": "0 2 * * 0"
    }
  ]
}
