# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Training data and artifacts (not deployed)
training/
# Keep scripts (exclude data, models, and outputs)
!training/prepare_dataset.py
!training/prepare_pilot_data.py
!training/supplement_and_train.py
!training/finetune_yolo26n.ipynb
!training/export_yolo_world.py

# YOLO / PyTorch model weights (large binary files)
*.pt
*.pth
# ONNX models in public/models/ and lib/models/ are tracked
# (needed for Vercel deployment — browser + server face detector)
# Other .onnx files are ignored
*.onnx
!public/models/*.onnx
!lib/models/*.onnx

# Training datasets (large, not for deployment)
datasets/

# Claude Code local project settings (machine-specific)
.claude/

# Internal security docs / draft communications — never push to public repo
/docs/security/
/security-email-draft.md
