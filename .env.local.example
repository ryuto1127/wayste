# ──────────────────────────────────────────────────────────
# Recycling Buddy Kiosk — Environment Variables
# Copy to .env.local for local development:  cp .env.local.example .env.local
# For Vercel: set these in Settings → Environment Variables
# ──────────────────────────────────────────────────────────

# ── Required ──

# OpenAI API key (GPT-5.4 nano/mini for classification)
OPENAI_API_KEY=sk-...

# Upstash Redis (auto-set by Vercel Marketplace integration)
KV_REST_API_URL=https://...upstash.io
KV_REST_API_TOKEN=...

# Vercel Blob (auto-set by Vercel Marketplace integration)
BLOB_READ_WRITE_TOKEN=vercel_blob_...

# ── Site Configuration ──

# Which config/sites/{SITE_ID}.json to load (default: "default")
# Available: default, japan-office, office-hq, airport, pilot
SITE_ID=default

# ── Authentication (Production only — leave unset for dev) ──

# Server-side: protects /api/classify, /api/feedback, /api/pilot-log
# Generate with: openssl rand -hex 32
# KIOSK_API_TOKEN=

# Client-side: sent as Authorization header from the kiosk browser
# Must be the SAME value as KIOSK_API_TOKEN
# NEXT_PUBLIC_KIOSK_TOKEN=

# Admin endpoints: protects /api/overrides POST
# Generate with: openssl rand -hex 32
# ADMIN_API_KEY=

# ── Optional ──

# Flip camera horizontally (for selfie/front-facing cameras during testing)
# NEXT_PUBLIC_MIRROR_CAMERA=true

# Max classify requests per 3-second window per IP (default: 15)
# RATE_LIMIT_MAX=15

# Set to "false" to disable image uploads to Vercel Blob entirely.
# Useful for privacy-sensitive deployments where images should not be stored.
# BLOB_ENABLED=false

# Days to keep Blob images before auto-cleanup cron deletes them (default: 7)
# BLOB_RETENTION_DAYS=7

# ── Edge Inference Backend ──

# Inference backend: "onnx" (browser WASM, default) or "http" (local server e.g. NCNN on RPi)
# NEXT_PUBLIC_INFERENCE_BACKEND=onnx

# URL for HTTP inference backend (only used when INFERENCE_BACKEND=http)
# Expected endpoints: POST /detect (image → detections), GET /health
# NEXT_PUBLIC_INFERENCE_URL=http://localhost:8000/detect
